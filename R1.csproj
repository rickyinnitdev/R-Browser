<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>RBrowser</AssemblyName>
    <RootNamespace>R1</RootNamespace>
    <AssemblyTitle>R Browser</AssemblyTitle>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>assets\r1.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>embedded</DebugType>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>1.0.0</Version>
    <Product>R Browser</Product>
    <Company>R Browser</Company>
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <!-- WebView2 ships a WPF assembly we never load; its WindowsBase reference
         conflicts harmlessly with the WinForms one. -->
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="R1.Linux\**" />
    <EmbeddedResource Remove="R1.Linux\**" />
    <None Remove="R1.Linux\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="assets\filters.dat" />
  </ItemGroup>

  <Target Name="CopyAssets" AfterTargets="Build">
    <ItemGroup>
      <R1Assets Include="$(MSBuildProjectDirectory)\assets\*.html;$(MSBuildProjectDirectory)\assets\*.css" />
    </ItemGroup>
    <Copy SourceFiles="@(R1Assets)" DestinationFolder="$(OutDir)assets" SkipUnchangedFiles="true" />
  </Target>

</Project>
